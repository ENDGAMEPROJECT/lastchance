# Copy to .env and fill in. .env is gitignored; this file is committed.
# xAPI LRS configuration. Without these, tracking is silently disabled
# and the game plays normally.
VITE_XAPI_ENDPOINT="https://your_lrs_host/data/xAPI"
# Base64-encoded key:secret - generate with: echo -n "key:secret" | base64
VITE_XAPI_AUTH="your_base64_encoded_key_secret"
