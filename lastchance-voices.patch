+#!/usr/bin/env node
+/* Records the characters' dialogue with Google Cloud Text-to-Speech, one MP3
+   per line, per language, per voice:
+
+     public/voices/<locale>/<key>.mp3   the tracks the game plays
+     src/game/voiceManifest.js          which keys have a track (generated)
+     docs/voices/<locale>.csv           every line: file, speaker, i18n key, text
+
+   Usage
+     npm run voices                     record whatever is missing
+     npm run voices -- --dry-run        list the lines and count characters, no API calls
+     npm run voices -- --locale=fi      one language only
+     npm run voices -- --only=pretest   only lines whose i18n key contains this
+     npm run voices -- --force          re-record lines that already have a track
+     npm run voices -- --prune          delete tracks no line uses any more
+
+   Auth (in .env, which is gitignored — never in a VITE_ variable, or it ships
+   in the public bundle):
+     GOOGLE_TTS_API_KEY=...            an API key allowed to call the Text-to-Speech API
+   or, if your project does not accept API keys for Gemini-TTS:
+     GOOGLE_TTS_ACCESS_TOKEN=$(gcloud auth print-access-token)
+     GOOGLE_CLOUD_PROJECT=your-project-id
+
+   Optional tuning (.env or environment):
+     TTS_MODEL=gemini-2.5-pro-tts      Gemini-TTS model (falls back to Chirp 3 HD if refused)
+     TTS_VOICE_MIA=Leda                any Gemini/Chirp 3 HD voice name
+     TTS_VOICE_MAX=Puck
+     TTS_CONCURRENCY=3
+
+   Lines are keyed by what is heard (language + speaker + final text), so after
+   `npm run i18n:import` changes the copy, running this again records only the
+   lines that changed. Which lines are voiced, and by whom, mirrors
+   EnterScreen, ReturnScreen, InPersonTest and FinalDecision — keep LINES below
+   in step if a scene starts using another key. */
+import { existsSync, mkdirSync, readFileSync, readdirSync, unlinkSync, writeFileSync } from 'node:fs'
+import { dirname, join } from 'node:path'
+import { fileURLToPath } from 'node:url'
+import dictionaries from '../src/i18n/dictionaries.js'
+import { characterVars, interpolate } from '../src/i18n/characterText.js'
+import { getNarrative } from '../src/game/characters.js'
+import { GAME_MINUTES } from '../src/game/gameData.js'
+import { voiceKey, voiceFile } from '../src/game/voiceKey.js'
+
+const ROOT = join(dirname(fileURLToPath(import.meta.url)), '..')
+
+/* ---------- options ---------- */
+const args = Object.fromEntries(process.argv.slice(2).map((a) => {
+  const [k, v] = a.replace(/^--/, '').split('=')
+  return [k, v ?? true]
+}))
+loadDotEnv(join(ROOT, '.env'))
+const env = process.env
+const DRY = Boolean(args['dry-run'])
+const FORCE = Boolean(args.force)
+const PRUNE = Boolean(args.prune)
+const ONLY = typeof args.only === 'string' ? args.only : null
+const LOCALES = typeof args.locale === 'string' ? args.locale.split(',') : Object.keys(dictionaries)
+const MODEL = env.TTS_MODEL || 'gemini-2.5-pro-tts'
+const CONCURRENCY = Number(env.TTS_CONCURRENCY) || 3
+
+/* ---------- casting ---------- */
+// Language codes sent to Google per game locale.
+const LANGUAGE = { en: 'en-US', es: 'es-ES', fi: 'fi-FI', sr: 'sr-RS' }
+const LANGUAGE_NAME = { en: 'English', es: 'Spanish from Spain', fi: 'Finnish', sr: 'Serbian' }
+const CAST = {
+  mia: { voice: env.TTS_VOICE_MIA || 'Leda', who: 'a 15-year-old girl' },
+  max: { voice: env.TTS_VOICE_MAX || 'Puck', who: 'a 15-year-old boy' },
+}
+// Gemini-TTS takes a natural-language direction alongside the text.
+const direction = (locale, speaker, name) =>
+  `You are ${name}, ${CAST[speaker].who}, talking out loud to your best friend from school. ` +
+  `Say the line in natural, native ${LANGUAGE_NAME[locale]} like a real teenager: casual, expressive, ` +
+  'quick and lively, never like a narrator or an advert. Say only the line itself.'
+
+/* ---------- which lines are spoken, and by whom ---------- */
+// role: 'player' = the character the player chose, 'friend' = the other one.
+const range = (n) => Array.from({ length: n }, (_, i) => i)
+const LINES = (lookup) => {
+  const rounds = lookup('story.rounds') || []
+  const count = (key) => (lookup(key) || []).length
+  return [
+    // School: the pre-test conversation (PretestScreen → InPersonTest).
+    { role: 'friend', key: 'story.pretest.opening' },
+    ...range(count('story.pretest.responses')).map((i) => ({ role: 'friend', key: `story.pretest.responses.${i}` })),
+    { role: 'friend', key: 'story.pretest.endingFriend' },
+    { role: 'player', key: 'story.pretest.endingYou' },
+    // The questions: the player says the option they pick; the friend reacts.
+    ...rounds.flatMap((round, r) => [
+      ...range(round.options?.length || 0).map((o) => ({ role: 'player', key: `story.rounds.${r}.options.${o}.text` })),
+      ...['why', 'nudge', 'positiveFeedback', 'negativeFeedback', 'followUpQuestion']
+        .map((field) => ({ role: 'friend', key: `story.rounds.${r}.${field}` })),
+    ]),
+    // Physical Internet arrival (EnterScreen); the HUD tour captions are not voiced.
+    { role: 'friend', key: 'enter.friendLine', vars: { minutes: GAME_MINUTES } },
+    { role: 'player', key: 'enter.playerLine', vars: { minutes: GAME_MINUTES } },
+    { role: 'player', key: 'enter.mission', vars: { minutes: GAME_MINUTES } },
+    { role: 'player', key: 'enter.finalLine', vars: { minutes: GAME_MINUTES } },
+    // Back from the last district (ReturnScreen): minutes = whole minutes left.
+    { role: 'player', key: 'return.playerLine' },
+    ...range(GAME_MINUTES).map((i) => ({ role: 'friend', key: 'return.friendLine', vars: { minutes: i + 1 } })),
+    { role: 'friend', key: 'return.friendLineTimeUp' },
+    // School again: the post-test (FinalDecision → InPersonTest).
+    ...range(count('story.posttest.friend.responses')).map((i) => ({ role: 'friend', key: `story.posttest.friend.responses.${i}` })),
+    ...range(count('story.posttest.player.responses')).map((i) => ({ role: 'player', key: `story.posttest.player.responses.${i}` })),
+    { role: 'friend', key: 'story.posttest.convinced' },
+    { role: 'friend', key: 'story.posttest.retryFriend' },
+    { role: 'player', key: 'story.posttest.endingYou' },
+    { role: 'friend', key: 'end.lose.reasons.notEnoughEvidenceConvincing.body' },
+    { role: 'friend', key: 'end.lose.reasons.notEnoughEvidenceUnconvincing.body' },
+  ]
+}
+
+/* ---------- resolve every line exactly as the game's t() does ---------- */
+const get = (dict, key) => key.split('.').reduce((acc, part) => (acc == null ? acc : acc[part]), dict)
+
+function collect(locale) {
+  const dict = dictionaries[locale]
+  const fallback = dictionaries.en
+  const lines = new Map()
+  for (const playerId of ['mia', 'max']) {
+    const narrative = getNarrative(playerId, dict.names)
+    const vars = characterVars(narrative, dict)
+    const lookup = (key) => get(dict, key) ?? get(fallback, key)
+    for (const line of LINES(lookup)) {
+      if (ONLY && !line.key.includes(ONLY)) continue
+      const template = lookup(line.key)
+      if (typeof template !== 'string' || !template.trim()) continue
+      const text = interpolate(template, { ...vars, ...line.vars })
+      if (/\{\w+\}/.test(text)) {
+        console.warn(`  ! ${locale} ${line.key}: unresolved placeholder, skipped → ${text}`)
+        continue
+      }
+      const speaker = line.role === 'player' ? narrative.character : narrative.friendId
+      const name = line.role === 'player' ? narrative.player : narrative.friend
+      const key = voiceKey(locale, speaker, text)
+      if (!lines.has(key)) lines.set(key, { key, locale, speaker, name, source: line.key, text })
+    }
+  }
+  return [...lines.values()]
+}
+
+/* ---------- Google Cloud Text-to-Speech ---------- */
+let useChirp = false // flips on if the Gemini model is refused
+async function synthesize(line) {
+  const languageCode = LANGUAGE[line.locale]
+  const voice = CAST[line.speaker].voice
+  const body = useChirp
+    ? { input: { text: line.text }, voice: { languageCode, name: `${languageCode}-Chirp3-HD-${voice}` }, audioConfig: { audioEncoding: 'MP3' } }
+    : {
+        input: { prompt: direction(line.locale, line.speaker, line.name), text: line.text },
+        voice: { languageCode, name: voice, modelName: MODEL },
+        audioConfig: { audioEncoding: 'MP3' },
+      }
+  const headers = { 'Content-Type': 'application/json' }
+  if (env.GOOGLE_TTS_ACCESS_TOKEN) {
+    headers.Authorization = `Bearer ${env.GOOGLE_TTS_ACCESS_TOKEN}`
+    if (env.GOOGLE_CLOUD_PROJECT) headers['x-goog-user-project'] = env.GOOGLE_CLOUD_PROJECT
+  } else headers['x-goog-api-key'] = env.GOOGLE_TTS_API_KEY
+
+  for (let attempt = 1; ; attempt++) {
+    const res = await fetch('https://texttospeech.googleapis.com/v1/text:synthesize', {
+      method: 'POST', headers, body: JSON.stringify(body),
+    })
+    if (res.ok) return Buffer.from((await res.json()).audioContent, 'base64')
+    const detail = await res.text()
+    if ((res.status === 429 || res.status >= 500) && attempt < 6) {
+      await new Promise((r) => setTimeout(r, 1000 * 2 ** attempt))
+      continue
+    }
+    if (!useChirp && (res.status === 400 || res.status === 403 || res.status === 404) && /model|gemini|not supported|permission|api key/i.test(detail)) {
+      console.warn(`\n  ! ${MODEL} was refused (${res.status}): ${detail.slice(0, 300)}\n  → switching to Chirp 3 HD voices for the rest of this run.\n`)
+      useChirp = true
+      return synthesize(line)
+    }
+    throw new Error(`${res.status} ${detail.slice(0, 500)}`)
+  }
+}
+
+/* ---------- run ---------- */
+const all = LOCALES.flatMap((locale) => {
+  if (!dictionaries[locale]) throw new Error(`Unknown locale "${locale}"`)
+  return collect(locale)
+})
+
+// Review sheet per language (always written, also on --dry-run).
+mkdirSync(join(ROOT, 'docs/voices'), { recursive: true })
+const csv = (v) => `"${String(v).replace(/"/g, '""')}"`
+for (const locale of LOCALES) {
+  const rows = all.filter((l) => l.locale === locale)
+  writeFileSync(join(ROOT, `docs/voices/${locale}.csv`),
+    ['file,speaker,i18n_key,text', ...rows.map((l) => [voiceFile(locale, l.key), l.speaker, l.source, l.text].map(csv).join(','))].join('\n') + '\n')
+}
+
+const todo = all.filter((l) => FORCE || !existsSync(join(ROOT, 'public', voiceFile(l.locale, l.key))))
+const chars = todo.reduce((n, l) => n + l.text.length, 0)
+console.log(`${all.length} voiced lines in ${LOCALES.join(', ')}; ${todo.length} to record (${chars} characters).`)
+for (const locale of LOCALES) {
+  const n = all.filter((l) => l.locale === locale).length
+  console.log(`  ${locale}: ${n} lines → docs/voices/${locale}.csv`)
+}
+
+if (DRY) process.exit(0)
+if (todo.length && !env.GOOGLE_TTS_API_KEY && !env.GOOGLE_TTS_ACCESS_TOKEN) {
+  console.error('\nSet GOOGLE_TTS_API_KEY (or GOOGLE_TTS_ACCESS_TOKEN) in .env first. See the top of this file.')
+  process.exit(1)
+}
+
+let done = 0
+let failed = 0
+const queue = [...todo]
+await Promise.all(Array.from({ length: CONCURRENCY }, async () => {
+  for (let line; (line = queue.shift());) {
+    const file = join(ROOT, 'public', voiceFile(line.locale, line.key))
+    try {
+      const mp3 = await synthesize(line)
+      mkdirSync(dirname(file), { recursive: true })
+      writeFileSync(file, mp3)
+      done++
+      process.stdout.write(`\r  recorded ${done}/${todo.length}`)
+    } catch (error) {
+      failed++
+      console.error(`\n  ✗ ${line.locale} ${line.speaker} ${line.source}: ${error.message}`)
+    }
+  }
+}))
+if (todo.length) console.log('')
+
+// Prune, then write the manifest from what is actually on disk.
+const wanted = new Set(all.map((l) => `${l.locale}/${l.key}`))
+const manifest = {}
+for (const locale of Object.keys(dictionaries)) {
+  const dir = join(ROOT, 'public/voices', locale)
+  const keys = existsSync(dir) ? readdirSync(dir).filter((f) => f.endsWith('.mp3')).map((f) => f.slice(0, -4)) : []
+  const keep = []
+  for (const key of keys) {
+    if (PRUNE && LOCALES.includes(locale) && !ONLY && !wanted.has(`${locale}/${key}`)) unlinkSync(join(dir, `${key}.mp3`))
+    else keep.push(key)
+  }
+  if (keep.length) manifest[locale] = keep.sort()
+}
+writeFileSync(join(ROOT, 'src/game/voiceManifest.js'),
+  '/* AUTO-GENERATED by `npm run voices`. Do not edit by hand.\n' +
+  '   Every voiced line that has a track in public/voices/<locale>/, by key. */\n' +
+  `export default ${JSON.stringify(manifest, null, 2)}\n`)
+
+console.log(`Done: ${done} recorded${failed ? `, ${failed} failed (run again to retry)` : ''}${useChirp ? ' (Chirp 3 HD fallback)' : ''}.`)
+if (failed) process.exitCode = 1
+
+function loadDotEnv(path) {
+  if (!existsSync(path)) return
+  for (const raw of readFileSync(path, 'utf8').split(/\r?\n/)) {
+    const m = raw.match(/^\s*([A-Z0-9_]+)\s*=\s*(.*)\s*$/)
+    if (m && !(m[1] in process.env)) process.env[m[1]] = m[2].replace(/^(['"])(.*)\1$/, '$2')
+  }
+}
