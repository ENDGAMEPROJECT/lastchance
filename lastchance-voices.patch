diff --git a/src/game/voice.js b/src/game/voice.js
new file mode 100644
index 0000000..4e71eed
--- /dev/null
+++ b/src/game/voice.js
@@ -0,0 +1,51 @@
+/* Character voices for the dialogue scenes. Tracks are pre-recorded by
+   `npm run voices` (scripts/generate-voices.mjs) into public/voices/<locale>/
+   and listed in voiceManifest.js; a line with no track simply stays silent,
+   so the game never waits on audio. Follows the global mute in sound.js. */
+import { useEffect } from 'react'
+import manifest from './voiceManifest.js'
+import { voiceKey, voiceFile } from './voiceKey.js'
+import { isMuted, onMuteChange } from './sound.js'
+import { settings } from './settings.js'
+import { useI18n } from '../i18n/index.jsx'
+
+const BASE = import.meta.env.BASE_URL
+const available = Object.fromEntries(Object.entries(manifest).map(([locale, keys]) => [locale, new Set(keys)]))
+
+// One element for every line: only one character talks at a time.
+let audio = null
+
+export function stopVoice() {
+  try { if (audio) { audio.pause(); audio.currentTime = 0 } } catch { /* ignore */ }
+}
+
+onMuteChange((muted) => { if (muted) stopVoice() })
+
+/* Say `text` as `speaker` ('mia' | 'max'). Returns false when there is no track. */
+export function playVoice(locale, speaker, text) {
+  stopVoice()
+  if (!settings.voice?.enabled || isMuted() || !text || !speaker) return false
+  const key = voiceKey(locale, speaker, text)
+  if (!available[locale]?.has(key)) return false
+  try {
+    if (!audio) audio = new Audio()
+    audio.src = `${BASE}${voiceFile(locale, key)}`
+    audio.volume = settings.voice.volume
+    audio.play().catch(() => {}) // autoplay rejections are harmless
+    return true
+  } catch {
+    return false
+  }
+}
+
+/* Voice the line currently on screen. Re-runs only when the speaker or text
+   changes, so a prompt that stays up while the options appear is not repeated;
+   the voice stops when the line changes or the scene unmounts. */
+export function useVoiceLine(speaker, text, enabled = true) {
+  const { locale } = useI18n()
+  useEffect(() => {
+    if (!enabled) return
+    playVoice(locale, speaker, text)
+    return stopVoice
+  }, [locale, speaker, text, enabled])
+}
diff --git a/src/game/voiceKey.js b/src/game/voiceKey.js
new file mode 100644
index 0000000..354983c
--- /dev/null
+++ b/src/game/voiceKey.js
@@ -0,0 +1,29 @@
+/* Shared by the game (voice.js) and the generator (scripts/generate-voices.mjs),
+   so both name a voiced line's file the same way. A track is identified by
+   what is actually heard: the language, who says it, and the final text after
+   {friend}/{minutes}/gendered-word substitution. Change the copy in the Sheet
+   and the key changes too, so a stale recording is never played for new text.
+   No import.meta / DOM here: this file must also run in plain Node. */
+
+const normalise = (text) => String(text).replace(/\s+/g, ' ').trim()
+
+// cyrb53: a small, fast 53-bit string hash (plenty for a few thousand lines).
+function cyrb53(str, seed = 0) {
+  let h1 = 0xdeadbeef ^ seed
+  let h2 = 0x41c6ce57 ^ seed
+  for (let i = 0; i < str.length; i++) {
+    const ch = str.charCodeAt(i)
+    h1 = Math.imul(h1 ^ ch, 2654435761)
+    h2 = Math.imul(h2 ^ ch, 1597334677)
+  }
+  h1 = Math.imul(h1 ^ (h1 >>> 16), 2246822507) ^ Math.imul(h2 ^ (h2 >>> 13), 3266489909)
+  h2 = Math.imul(h2 ^ (h2 >>> 16), 2246822507) ^ Math.imul(h1 ^ (h1 >>> 13), 3266489909)
+  return 4294967296 * (2097151 & h2) + (h1 >>> 0)
+}
+
+/* `speaker` is the character ID ('mia' | 'max'), never the display name. */
+export function voiceKey(locale, speaker, text) {
+  return cyrb53(`${locale}|${speaker}|${normalise(text)}`).toString(36)
+}
+
+export const voiceFile = (locale, key) => `voices/${locale}/${key}.mp3`
